NODE_ENV=production
PORT=8080
DATA_DIR=/data
PUBLIC_HOST=repair.nenosensei.com
STAFF_HOST=staff.nenosensei.com
PUBLIC_BASE_URL=https://repair.nenosensei.com
STAFF_BASE_URL=https://staff.nenosensei.com

# Existing owner bootstrap. ADMIN_PASSWORD_HASH must be bcrypt; never plain text.
ADMIN_USERNAME=admin
ADMIN_EMAIL=repair@nenosensei.com
ADMIN_PASSWORD_HASH=

# Generate each as an independent 32-byte random secret. MFA accepts base64 or 64 hex.
MFA_ENCRYPTION_KEY=
BACKUP_HEARTBEAT_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Neno’s IT Repair <repair@nenosensei.com>
REPAIR_REPLY_TO=repair@nenosensei.com

# Add only after a verified Google Business Profile provides the final review URL.
GOOGLE_REVIEW_URL=
